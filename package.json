{
  "name": "sz-pi-extensions",
  "version": "1.0.0",
  "description": "SZ pi extensions — enhanced footer, git view, Ketch research, and more",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "postinstall": "node ./scripts/install-append-system.mjs && node ./scripts/install-ketch.mjs",
    "test": "node --test",
    "typecheck:ssh-image-paste": "tsc --noEmit --skipLibCheck --strict --target es2023 --module nodenext extensions/ssh-image-paste.ts"
  },
  "bundledDependencies": [
    "sz-pi-subagents",
    "pi-claude-bridge"
  ],
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/pi-claude-bridge/src/index.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/sz-pi-subagents/skills",
      "node_modules/ketch/skills/ketch"
    ]
  },
  "dependencies": {
    "linkedom": "^0.16.11",
    "pi-claude-bridge": "0.9.1",
    "pngjs": "^7.0.0",
    "sz-pi-subagents": "https://github.com/stanley50z/sz-pi-subagents/archive/77ce0f259ab8b03adf007ca6e0b22df94fa4dfc1.tar.gz"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "^0.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  }
}
