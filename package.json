{
  "name": "sz-pi-extensions",
  "version": "1.0.0",
  "description": "SZ pi extensions — enhanced footer, git view, Chrome DevTools, Ketch research, and more",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "build:git-view-css": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -c extensions/sz-git-view/tailwind.config.cjs -i extensions/sz-git-view/src/git-view.css -o extensions/sz-git-view/dist/git-view.css --minify",
    "postinstall": "node ./scripts/install-ketch.mjs",
    "test": "node --test"
  },
  "bundledDependencies": ["sz-pi-subagents"],
  "pi": {
    "extensions": [
      "./extensions",
      "node_modules/sz-pi-subagents/extensions/subagents/index.ts"
    ],
    "skills": [
      "./skills",
      "node_modules/sz-pi-subagents/skills",
      "node_modules/ketch/skills/ketch"
    ]
  },
  "dependencies": {
    "sz-pi-subagents": "https://github.com/stanley50z/sz-pi-subagents/archive/1dfc46e.tar.gz",
    "chrome-devtools-mcp": "^0.26.0",
    "linkedom": "^0.16.11",
    "typebox": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
